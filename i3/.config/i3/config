font pango:monospace 11
floating_modifier Mod4
focus_follows_mouse no
focus_wrapping no

client.background #1a1b26
client.focused #7aa2f7 #7aa2f7 #15161e #16161e #16161e
client.focused_inactive #16161e #16161e #3b4261 #16161e
client.unfocused #16161e #16161e #3b4261 #16161e
client.urgent #db4b4b #db4b4b #15161e #16161e #16161e

bindsym Mod4+Return exec --no-startup-id xterm
bindsym Mod4+d exec --no-startup-id dmenu_run -fn monospace:size=12 -nb '#16161e' -nf '#3b4261' -sb '#7aa2f7' -sf '#15161e'
bindsym Mod4+b exec --no-startup-id chromium

bindsym Mod4+Shift+q kill

bindsym Mod4+h focus left
bindsym Mod4+j focus down
bindsym Mod4+k focus up
bindsym Mod4+l focus right
bindsym Mod4+Left focus left
bindsym Mod4+Down focus down
bindsym Mod4+Up focus up
bindsym Mod4+Right focus right

bindsym Mod4+Shift+h move left
bindsym Mod4+Shift+j move down
bindsym Mod4+Shift+k move up
bindsym Mod4+Shift+l move right
bindsym Mod4+Shift+Left move left
bindsym Mod4+Shift+Down move down
bindsym Mod4+Shift+Up move up
bindsym Mod4+Shift+Right move right

bindsym Mod4+v split h
bindsym Mod4+s split v
bindsym Mod4+f fullscreen toggle
bindsym Mod4+w layout tabbed
bindsym Mod4+e layout toggle split
bindsym Mod4+Shift+button1 --whole-window floating toggle

bindsym Mod4+1 workspace number 1
bindsym Mod4+2 workspace number 2
bindsym Mod4+3 workspace number 3
bindsym Mod4+4 workspace number 4
bindsym Mod4+5 workspace number 5
bindsym Mod4+6 workspace number 6
bindsym Mod4+7 workspace number 7
bindsym Mod4+8 workspace number 8
bindsym Mod4+9 workspace number 9
bindsym Mod4+Tab workspace back_and_forth

bindsym Mod4+Shift+1 move container to workspace number 1, workspace number 1
bindsym Mod4+Shift+2 move container to workspace number 2, workspace number 2
bindsym Mod4+Shift+3 move container to workspace number 3, workspace number 3
bindsym Mod4+Shift+4 move container to workspace number 4, workspace number 4
bindsym Mod4+Shift+5 move container to workspace number 5, workspace number 5
bindsym Mod4+Shift+6 move container to workspace number 6, workspace number 6
bindsym Mod4+Shift+7 move container to workspace number 7, workspace number 7
bindsym Mod4+Shift+8 move container to workspace number 8, workspace number 8
bindsym Mod4+Shift+9 move container to workspace number 9, workspace number 9

bindsym Mod4+r mode "resize"

bindsym Mod4+Shift+r reload
bindsym Mod4+Shift+Escape exit

bindsym Mod1+Shift+q focus parent, kill

bindsym Mod1+h focus parent, focus left, focus child
bindsym Mod1+j focus parent, focus down, focus child
bindsym Mod1+k focus parent, focus up, focus child
bindsym Mod1+l focus parent, focus right, focus child
bindsym Mod1+Left focus parent, focus left, focus child
bindsym Mod1+Down focus parent, focus down, focus child
bindsym Mod1+Up focus parent, focus up, focus child
bindsym Mod1+Right focus parent, focus right, focus child

bindsym Mod1+Shift+h focus parent, move left, focus child
bindsym Mod1+Shift+j focus parent, move down, focus child
bindsym Mod1+Shift+k focus parent, move up, focus child
bindsym Mod1+Shift+l focus parent, move right, focus child
bindsym Mod1+Shift+Left focus parent, move left, focus child
bindsym Mod1+Shift+Down focus parent, move down, focus child
bindsym Mod1+Shift+Up focus parent, move up, focus child
bindsym Mod1+Shift+Right focus parent, move right, focus child

bindsym Mod1+v focus parent, split h
bindsym Mod1+s focus parent, split v
bindsym Mod1+f focus parent, fullscreen toggle, focus child
bindsym Mod1+w focus parent, layout tabbed, focus child
bindsym Mod1+e focus parent, layout toggle split, focus child

bindsym Mod1+Shift+1 focus parent, move container to workspace number 1, workspace number 1
bindsym Mod1+Shift+2 focus parent, move container to workspace number 2, workspace number 2
bindsym Mod1+Shift+3 focus parent, move container to workspace number 3, workspace number 3
bindsym Mod1+Shift+4 focus parent, move container to workspace number 4, workspace number 4
bindsym Mod1+Shift+5 focus parent, move container to workspace number 5, workspace number 5
bindsym Mod1+Shift+6 focus parent, move container to workspace number 6, workspace number 6
bindsym Mod1+Shift+7 focus parent, move container to workspace number 7, workspace number 7
bindsym Mod1+Shift+8 focus parent, move container to workspace number 8, workspace number 8
bindsym Mod1+Shift+9 focus parent, move container to workspace number 9, workspace number 9

bindsym Mod1+r focus parent, mode "resize"

mode "resize" {
        bindsym h resize shrink width 5 px or 5 ppt
        bindsym j resize grow height 5 px or 5 ppt
        bindsym k resize shrink height 5 px or 5 ppt
        bindsym l resize grow width 5 px or 5 ppt

        bindsym Left resize shrink width 5 px or 5 ppt
        bindsym Down resize grow height 5 px or 5 ppt
        bindsym Up resize shrink height 5 px or 5 ppt
        bindsym Right resize grow width 5 px or 5 ppt

        bindsym Escape mode "default", focus child
}

bindsym XF86AudioRaiseVolume exec --no-startup-id wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+ -l 1
bindsym XF86AudioLowerVolume exec --no-startup-id wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
bindsym XF86AudioMute exec --no-startup-id wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
bindsym XF86AudioMicMute exec --no-startup-id wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle

bindsym XF86MonBrightnessUp exec --no-startup-id brightnessctl s 5%+
bindsym XF86MonBrightnessDown exec --no-startup-id brightnessctl s 5%-

bindsym Print exec --release maim -us | xclip -selection clipboard -t image/png
bindsym Mod4+Shift+s exec --release maim -us | xclip -selection clipboard -t image/png

bar {
        status_command i3status
        colors {
                background #16161e
                separator #c0caf5
                focused_workspace #7aa2f7 #7aa2f7 #15161e
                active_workspace #7aa2f7 #15161e #7aa2f7
                inactive_workspace #16161e #16161e #3b4261
        }
}
