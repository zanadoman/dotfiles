sbctl create-keys
sbctl enroll-keys -m
sudo sbctl sign -s /boot/EFI/BOOT/BOOTX64.EFI
sudo sbctl sign -s /boot/EFI/Linux/arch-linux.efi
sudo sbctl sign -s /boot/EFI/systemd/systemd-bootx64.efi
sudo sbctl sign -s /boot/vmlinuz-linux
sudo sbctl verify

sudo nmcli connection import type wireguard file sentinel.conf
sudo nmcli connection modify sentinel connection.autoconnect no
sudo nmcli connection modify sentinel +ipv4.routes 192.168.1.0/24
